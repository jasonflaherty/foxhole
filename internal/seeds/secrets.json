[
  {
    "id": "aws-access-key",
    "name": "AWS Access Key ID",
    "pattern": "\\b(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "aws-secret-access-key",
    "name": "AWS Secret Access Key assignment",
    "pattern": "(?i)(aws)?_?secret_?(access)?_?key\\s*[=:]\\s*['\"]?[A-Za-z0-9/+=]{40}['\"]?",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "gcp-api-key",
    "name": "Google Cloud / Maps API key",
    "pattern": "\\bAIza[0-9A-Za-z\\-_]{35}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "gcp-service-account",
    "name": "GCP service account JSON marker",
    "pattern": "\"type\"\\s*:\\s*\"service_account\"",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "azure-storage-account-key",
    "name": "Azure Storage AccountKey",
    "pattern": "(?i)AccountKey=[A-Za-z0-9+/=]{60,}",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "azure-ad-client-secret",
    "name": "Azure AD client secret assignment",
    "pattern": "(?i)(azure[_-]?client[_-]?secret|aad[_-]?client[_-]?secret|client[_-]?secret)\\s*[=:]\\s*['\"][^'\"]{16,}['\"]",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "github-pat",
    "name": "GitHub personal access token",
    "pattern": "\\bghp_[A-Za-z0-9]{36}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "github-oauth",
    "name": "GitHub OAuth access token",
    "pattern": "\\bgho_[A-Za-z0-9]{36}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "github-app-token",
    "name": "GitHub App user/server token",
    "pattern": "\\b(ghu|ghs)_[A-Za-z0-9]{36}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "github-refresh",
    "name": "GitHub refresh token",
    "pattern": "\\bghr_[A-Za-z0-9]{36,}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "github-fine-grained-pat",
    "name": "GitHub fine-grained personal access token",
    "pattern": "\\bgithub_pat_[A-Za-z0-9]{22}_[A-Za-z0-9]{59}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "private-key",
    "name": "PEM / OpenSSH private key header",
    "pattern": "-----BEGIN (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "pgp-private-key",
    "name": "PGP private key block",
    "pattern": "-----BEGIN PGP PRIVATE KEY BLOCK-----",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "jwt",
    "name": "JSON Web Token",
    "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]+\\b",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "slack-token",
    "name": "Slack token",
    "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "slack-webhook",
    "name": "Slack incoming webhook URL",
    "pattern": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9_]+/B[A-Za-z0-9_]+/[A-Za-z0-9_]+",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "stripe-secret-key",
    "name": "Stripe secret/restricted key",
    "pattern": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{20,}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "sendgrid-api-key",
    "name": "SendGrid API key",
    "pattern": "\\bSG\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\b",
    "severity": "critical",
    "enabled": true
  },
  {
    "id": "twilio-api-key",
    "name": "Twilio API key SID",
    "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
    "severity": "high",
    "enabled": true
  },
  {
    "id": "generic-api-key",
    "name": "Generic API key assignment",
    "pattern": "(?i)(api[_-]?key|apikey|secret[_-]?key)\\s*[=:]\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]",
    "severity": "high",
    "enabled": true
  }
]
