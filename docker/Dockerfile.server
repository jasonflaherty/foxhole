# foxhole-server — REST API + dashboard
# Build: docker build -t foxhole-server -f docker/Dockerfile.server .
# Run:   docker run --rm -p 8080:8080 -v foxhole-data:/var/lib/foxhole foxhole-server

FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=0.3.0
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X github.com/jasonflaherty/foxhole/internal/version.Version=${VERSION}" -o /out/foxhole ./cmd/foxhole

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
	&& adduser -D -u 1000 -h /var/lib/foxhole foxhole \
	&& mkdir -p /var/lib/foxhole \
	&& chown -R foxhole:foxhole /var/lib/foxhole
COPY --from=build /out/foxhole /usr/local/bin/foxhole
USER foxhole
WORKDIR /work
ENV FOXHOLE_DB_PATH=/var/lib/foxhole/foxhole.db
VOLUME ["/var/lib/foxhole"]
EXPOSE 8080
ENTRYPOINT ["foxhole", "serve", "--addr", ":8080"]
