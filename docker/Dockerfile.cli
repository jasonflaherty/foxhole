# foxhole-cli — offline-first supply chain scanner
# Build: docker build -t foxhole -f docker/Dockerfile.cli .
#    or: podman build -t foxhole -f docker/Dockerfile.cli .

FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/foxhole ./cmd/foxhole

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
	&& adduser -D -u 1000 -h /var/lib/foxhole foxhole \
	&& mkdir -p /var/lib/foxhole \
	&& chown -R foxhole:foxhole /var/lib/foxhole
COPY --from=build /out/foxhole /usr/local/bin/foxhole
USER foxhole
WORKDIR /work
ENV FOXHOLE_DB_PATH=/var/lib/foxhole/foxhole.db
VOLUME ["/var/lib/foxhole"]
ENTRYPOINT ["foxhole"]
CMD ["--help"]
